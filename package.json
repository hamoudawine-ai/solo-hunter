{

  "name": "solo-hunter-system",

  "private": true,

  "version": "7.0.19",

  "description": "SOLO HUNTER - Game Verification System",

  "author": "Hamoudawine AI",

  "repository": {

    "type": "git",

    "url": "https://github.com/hamoudawine-ai/solo-hunter.git"

  },

  "type": "module",

  "main": "main.js",

  "scripts": {

    "dev": "vite --port 5888",

    "clean": "node ./scripts/clean-build.js",

    "build": "vite build && electron-builder",

    "preview": "vite preview",

    "electron": "wait-on http://localhost:5888 && electron .",

    "start": "concurrently \"npm run dev\" \"npm run electron\"",

    "package": "npm run build",

    "dist": "npm run build",

    "publish": "vite build && electron-builder --win --x64 --publish never && powershell Compress-Archive -Path ./dist_electron/win-unpacked -DestinationPath ./dist_electron/SOLO-HUNTER-7.0.19.zip -Force && powershell Compress-Archive -Path ./dist_electron/SOLO-HUNTER-7.0.19.zip, ./dist_electron/SOLO-HUNTER-Portable.bat -DestinationPath ./dist_electron/SOLO-HUNTER-Portable-7.0.19.zip -Force && powershell -ExecutionPolicy Bypass -File ./upload-release.ps1",

    "release:patch": "npm version patch --no-git-tag-version && npm run publish",

    "release:minor": "npm version minor --no-git-tag-version && npm run publish",

    "release:major": "npm version major --no-git-tag-version && npm run publish"

  },

  "build": {

    "appId": "com.solo.hunter.system",

    "productName": "SOLO HUNTER",

    "directories": {

      "output": "dist_electron"

    },

    "files": [

      "dist/**/*",

      "main.js",

      "preload.cjs",

      "package.json",

      "games.json"

    ],

    "extraResources": [

      "public/system-logo.png"

    ],

    "win": {

      "icon": "public/icon.ico",

      "target": "portable",

      "defaultArch": "x64",

      "artifactName": "SOLO-HUNTER-${version}.${ext}"

    },

    "nsis": {

      "oneClick": false,

      "perMachine": false,

      "allowToChangeInstallationDirectory": true,

      "installerIcon": "public/icon.ico",

      "uninstallerIcon": "public/icon.ico",

      "installerHeaderIcon": "public/icon.ico",

      "createDesktopShortcut": true,

      "createStartMenuShortcut": true,

      "shortcutName": "SOLO HUNTER"

    },

    "asar": true,

    "asarUnpack": [

      "resources/**/*"

    ],

    "afterPack": "scripts/inject-icon.cjs",

    "publish": [

      {

        "provider": "github",

        "owner": "hamoudawine-ai",

        "repo": "solo-hunter",

        "releaseType": "release"

      }

    ]

  },

  "dependencies": {

    "discord-rpc": "^4.0.1",

    "framer-motion": "^12.38.0",

    "gsap": "^3.15.0",

    "howler": "^2.2.4",

    "lucide-react": "^1.14.0",

    "puppeteer": "^24.43.1",

    "react": "^18.2.0",

    "react-dom": "^18.2.0",

    "three": "^0.184.0"

  },

  "devDependencies": {

    "@ljharb/tsconfig": "^0.3.2",

    "@types/react": "^18.2.15",

    "@types/react-dom": "^18.2.7",

    "@vitejs/plugin-react": "^5.2.0",

    "autoprefixer": "^10.4.14",

    "concurrently": "^8.2.0",

    "electron": "^41.5.0",

    "electron-builder": "^26.8.1",

    "electron-is-dev": "^2.0.0",

    "icojs": "^0.23.0",

    "postcss": "^8.4.27",

    "rcedit": "^2.1.0",

    "sharp": "^0.34.5",

    "tailwindcss": "^3.3.3",

    "to-ico": "^1.1.5",

    "vite": "^8.0.10",

    "wait-on": "^7.0.1",

    "yaml": "^2.8.4"

  }

}

